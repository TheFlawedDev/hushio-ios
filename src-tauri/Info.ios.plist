<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated iOS Info.plist by Tauri during `tauri ios build`
  (Tauri looks for Info.plist / Info.ios.plist next to tauri.conf.json).

  Only the keys this port genuinely needs are listed; everything else is left to the
  generated default so regeneration stays predictable.

  - UIBackgroundModes:audio      -> playback continues when the app is backgrounded or the
                                    screen locks (required by Phase C background audio).
  - CFBundleURLTypes             -> custom-scheme returns for OAuth (ASWebAuthenticationSession)
                                    and the app's own `hushio` scheme.
  - LSSupportsOpeningDocumentsInPlace -> silences the Xcode warning and lets the document
                                    picker hand out security-scoped folder URLs in place.
-->
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!--
	  BGTaskScheduler refuses to submit a task whose identifier is not listed here, so
	  `HushioSyncTask.scheduleRetry()` would reject `bg_task_not_permitted` forever and the
	  sync-retry seam would be dead on arrival. The value must match
	  src-tauri/tauri-plugin-hushio-player/ios/Sources/ServicesEngine.swift::HushioSyncTask.identifier
	  and the handler registered in HushioServicePlugins.swift.
	-->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.hushio.app.iosdev.background-sync</string>
	</array>

	<!--
	  The Rust stream proxy serves media over http://127.0.0.1:<port> and debug builds load
	  the renderer from the Vite dev server on the same loopback. ATS otherwise refuses
	  cleartext to non-TLS hosts. NSAllowsLocalNetworking is the narrow, Apple-documented
	  exemption for exactly this; arbitrary (public) cleartext stays blocked, so remote
	  sources must keep using HTTPS.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>CFBundleURLTypes</key>	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hushio.app.iosdev.oauth</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Must match src-tauri/src/ios_scheme.rs::REDIRECT_SCHEME and the
				     ASWebAuthenticationSession callbackURLScheme in ServicesEngine.swift. -->
				<string>com.hushio.app.iosdev</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hushio.app.iosdev.spotify</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- src-tauri/src/spotify_auth.rs::IOS_SCHEME -->
				<string>hushio-spotify</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hushio.app.iosdev.app</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Same app scheme the desktop deep-link plugin registers. -->
				<string>hushio</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
